# Optional: the base app needs no keys. Copy to .env only to customize.
# AIRPORT_DATABASE_PATH=/absolute/path/to/persistent/airport.sqlite
# AIRPORT_MIGRATIONS_PATH=/absolute/path/to/drizzle
# HOST=127.0.0.1
# PORT=3000
# TRAFFIC_PROVIDER_ORDER=adsb-lol,adsb-fi

# Paid origin/destination lookups are OFF. Token alone never enables them.
# Read docs/OPERATIONS.md before enabling. Each operator owns their own account.
FR24_DATA_ENABLED=false
FR24_DISPLAY_CACHE_APPROVED=false
FR24_OWNER_EXPERIMENT=false
FR24_PRIVATE_EXPERIMENT=false
# FR24_API_TOKEN=
# FR24_BILLING_PERIOD_START=
# FR24_BILLING_PERIOD_END=
# FR24_CREDIT_ALLOWANCE=
# FR24_DAILY_CREDIT_LIMIT=
# FR24_PACING_BURST_CREDITS=
FR24_CACHE_TTL_SECONDS=7200
FR24_NEGATIVE_CACHE_TTL_SECONDS=300
FR24_USUAL_CACHE_TTL_SECONDS=300
AIRPORT_OPS_DASHBOARD_ENABLED=false
# ROUTE_MAINTENANCE_TOKEN=
