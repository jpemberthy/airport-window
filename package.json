{
  "name": "airport-window",
  "version": "1.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "node scripts/collect-licenses.mjs && vinext build",
    "build:node": "npm run build",
    "start": "node scripts/serve.mjs",
    "start:node": "node scripts/serve.mjs",
    "lint": "oxlint",
    "format": "oxfmt",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:init": "node --env-file-if-exists=.env scripts/database.mjs init",
    "db:prune": "node --env-file-if-exists=.env scripts/database.mjs prune",
    "check:pack": "node scripts/check-pack.mjs",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "d3-geo": "^3.1.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "1.31.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-server-dom-webpack": "19.3.1",
    "suncalc": "^2.0.2",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.4.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "22.19.19",
    "@types/d3-geo": "^3.1.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.37",
    "jsdom": "^27.0.1",
    "oxfmt": "0.79.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "@playwright/test": "1.65.1"
  },
  "type": "module",
  "license": "MIT",
  "overrides": {
    "fflate": "^0.7.5"
  }
}
